# Fluxer OAuth2 application. Register FLUXER_REDIRECT_URI on it.
FLUXER_CLIENT_ID=""
FLUXER_CLIENT_SECRET=""
FLUXER_SCOPES="identify guilds"
FLUXER_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# API URL of a self-hosted Fluxer instance, such as https://api.example.org.
# Leave empty for fluxer.app. Must match FluxerInstanceUrl in credentials.json.
FLUXER_INSTANCE_URL=""

# Generate with: openssl rand -base64 32
COOKIE_ENCRYPTION_PASSWORD=""

# Must match ApiKey and JwtSecret in credentials.json.
PUBLIC_MEWDEKO_API_URL="http://mewdeko:5001/botapi"
MEWDEKO_API_KEY=""
BOT_JWT_SECRET=""

# The Compose Redis service and the first ten characters of the Fluxer bot token.
USE_REDIS=true
REDIS_URL="redis"
REDIS_KEY=""

# Optional: let members link a Discord account and bring a Discord server over.
DISCORD_LINK_CLIENT_ID=""
DISCORD_LINK_CLIENT_SECRET=""
DISCORD_LINK_REDIRECT_URI="http://localhost:3000/api/discord-link/callback"

NODE_ENV=production
